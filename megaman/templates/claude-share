#!/usr/bin/env python3
"""claude-share — put files from this session's project folder on the owner's phone.

Installed to ~/.claude/bin/ by claude-pm (source: claude-pm/templates/).

    claude-share renders/top.png renders/iso.png --caption "v12 renders"

The Claude app's own "send file" tool needs a claude.ai project thread, which
remote-control sessions don't have, so it never delivers. This drops a small
request in the bot's queue instead, and the bot posts the files to Discord.
Nothing is copied or uploaded anywhere else: the files stay where they are, in
the project folder. The bot checks every path again and refuses anything
outside that folder, so this can't leak files from elsewhere on the laptop.
"""
import json
import os
import re
import sys
import time
from pathlib import Path

MAX_FILES = 10                  # Discord: attachments per message
MAX_BYTES = 10 * 1024 * 1024    # Discord: per-file limit without boosts
STATE_DIR = Path(os.environ.get("CLAUDE_PM_STATE",
                                Path.home() / ".cache" / "claude-pm"))
QUEUE_DIR = STATE_DIR / "share_queue"
SCOPE_RE = re.compile(r"^claude-(?:cp|job)-(.+)\.scope$")


def session_project() -> str:
    """Project of the bot session this runs in, from its systemd scope
    (`claude-cp-myproj.scope` → `myproj`), or "" outside a bot session."""
    try:
        rel = Path("/proc/self/cgroup").read_text().strip().split("::", 1)[1]
    except (OSError, IndexError):
        return ""
    for part in reversed(rel.split("/")):
        m = SCOPE_RE.match(part)
        if m:
            return m.group(1)
    return ""


def main(argv: list) -> int:
    caption, files, i = "", [], 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if a in ("-c", "--caption"):
            caption = argv[i + 1] if i + 1 < len(argv) else ""
            i += 2
            continue
        if a.startswith("--caption="):
            caption = a.split("=", 1)[1]
        else:
            files.append(a)
        i += 1
    if not files:
        print('Usage: claude-share <file> [<file> ...] [--caption "what it is"]')
        return 2

    project = session_project()
    if not project:
        print("claude-share: not running inside a claude-pm session, so there's "
              "no bot to post through.")
        return 1
    if len(files) > MAX_FILES:
        print(f"claude-share: at most {MAX_FILES} files per share; split them up.")
        return 2

    paths, bad = [], []
    for f in files:
        p = Path(f).expanduser().resolve()
        if not p.is_file():
            bad.append(f"{f}: not a file")
        elif p.stat().st_size > MAX_BYTES:
            bad.append(f"{f}: {p.stat().st_size / 2**20:.1f} MB, over Discord's 10 MB "
                       "limit (shrink or zip it)")
        else:
            paths.append(str(p))
    if bad:
        print("claude-share: nothing sent:\n  " + "\n  ".join(bad))
        return 1

    req = {"project": project, "files": paths, "caption": caption.strip(),
           "at": time.time()}
    try:
        QUEUE_DIR.mkdir(parents=True, exist_ok=True)
        name = f"{time.time_ns()}-{os.getpid()}.json"
        tmp = QUEUE_DIR / (name + ".tmp")
        tmp.write_text(json.dumps(req))
        os.replace(tmp, QUEUE_DIR / name)
    except OSError as e:
        print(f"claude-share: could not queue the files ({e}).")
        return 1
    print(f"Queued {len(paths)} file(s) for Discord; the bot posts them within "
          "about 10 seconds.")
    print("They stay in the project folder. If the owner doesn't see them, the bot "
          "rejected them and said why in the channel.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
