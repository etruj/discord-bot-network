#!/bin/bash
# claude-pm: a Claude session's `sudo`. Installed to ~/.claude/bin/sudo, which
# sessions get first on PATH. Routes through the root-owned gate, which decides
# what this session may run as root (see /usr/local/sbin/cpm-sudo). Until the
# gate is installed it is exactly plain sudo.
if [ -x /usr/local/sbin/cpm-sudo ]; then
    exec /usr/bin/sudo -n /usr/local/sbin/cpm-sudo "$@"
fi
exec /usr/bin/sudo "$@"
