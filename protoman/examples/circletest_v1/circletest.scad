// circletest — generated by protobot from a sketch (input.jpg)
// 2026-10-28
//
// Print: Prusa Core One, 0.4 mm nozzle, PLA, 0.2 mm layers, flat on the bed.
// The outline is stored in a 0..1 unit box and scaled by LENGTH/WIDTH, so
// the three measurements below are all you need to change. Re-export with:
//   openscad --backend=manifold --export-format binstl -o circletest.stl circletest.scad
//
// Dimension tags: [M] = given by the user, [S] = traced from the sketch.

/* [Measurements] */
LENGTH    = 40;   // [M] X extent, mm
WIDTH     = 40;   // [M] Y extent, mm
THICKNESS = 20;   // [M] extrusion height, mm

/* [Edge finish] */
// Perimeter edges (outline AND holes), top and bottom faces.
// "fillet" = rounded, "chamfer" = 45°, "none" = sharp. Built in LAYER steps,
// i.e. exactly as the printer will lay it down.
EDGE_TOP_KIND    = "none";
EDGE_TOP         = 0;     // mm
EDGE_BOTTOM_KIND = "none";
EDGE_BOTTOM      = 0;     // mm
LAYER            = 0.2;   // mm, print layer height

/* [Version stamp] */
VERSION        = 1;       // bump every revision
VERSION_POS    = [0.5000, 0.5000];  // [S] unit-box spot deepest inside the shape
VERSION_SIZE   = 6;      // mm text height
VERSION_DEPTH  = 0.4;    // mm, 2 layers at 0.2

/* [Screws and nuts] */
// One entry per screw hole: [x, y] in the unit box (scaled by LENGTH/WIDTH),
// then its cuts: ["circle", Ø] = screw-head recess, ["hex", across flats] =
// nut pocket, each [.., depth mm, "top"|"bottom"]. The clearance hole itself
// is part of the outline below.
FASTENERS = [];

/* [Hidden] */
// [S] traced outline (+ holes), unit box, y up.
OUTLINE_PTS = [
    [1.00000,0.49977], [0.99960,0.47984], [0.99841,0.45994], [0.99642,0.44010], [0.99196,0.41053], [0.98801,0.39099],
    [0.98063,0.36201], [0.97475,0.34296], [0.96451,0.31486], [0.95676,0.29649], [0.94378,0.26955], [0.92921,0.24343],
    [0.91864,0.22652], [0.90154,0.20198], [0.88933,0.18621], [0.86987,0.16350], [0.85616,0.14902], [0.84187,0.13510],
    [0.81944,0.11531], [0.79586,0.09690], [0.77955,0.08543], [0.75425,0.06945], [0.73688,0.05966], [0.71011,0.04628],
    [0.69185,0.03826], [0.67328,0.03098], [0.64491,0.02146], [0.61603,0.01365], [0.59654,0.00940], [0.57689,0.00594],
    [0.54720,0.00222], [0.52731,0.00073], [0.50000,0.00000], [0.47269,0.00073], [0.45280,0.00222], [0.42311,0.00594],
    [0.40346,0.00940], [0.38397,0.01365], [0.35509,0.02146], [0.32672,0.03098], [0.30815,0.03826], [0.28989,0.04628],
    [0.26312,0.05966], [0.24575,0.06945], [0.22045,0.08543], [0.20414,0.09690], [0.18056,0.11531], [0.15813,0.13510],
    [0.14384,0.14902], [0.13013,0.16350], [0.11067,0.18621], [0.09846,0.20198], [0.08136,0.22652], [0.07079,0.24343],
    [0.05622,0.26955], [0.04324,0.29649], [0.03549,0.31486], [0.02525,0.34296], [0.01937,0.36201], [0.01199,0.39099],
    [0.00804,0.41053], [0.00358,0.44010], [0.00159,0.45994], [0.00040,0.47984], [0.00000,0.50023], [0.00040,0.52016],
    [0.00159,0.54006], [0.00358,0.55990], [0.00804,0.58947], [0.01199,0.60901], [0.01937,0.63799], [0.02525,0.65704],
    [0.03549,0.68514], [0.04324,0.70351], [0.05622,0.73045], [0.07079,0.75657], [0.08136,0.77348], [0.09846,0.79802],
    [0.11067,0.81379], [0.13013,0.83650], [0.14384,0.85098], [0.15813,0.86490], [0.18056,0.88469], [0.20414,0.90310],
    [0.22045,0.91457], [0.24575,0.93055], [0.26312,0.94034], [0.28989,0.95372], [0.30815,0.96174], [0.32672,0.96902],
    [0.35509,0.97854], [0.38397,0.98635], [0.40346,0.99060], [0.42311,0.99406], [0.45280,0.99778], [0.47269,0.99927],
    [0.50000,1.00000], [0.52731,0.99927], [0.54720,0.99778], [0.57689,0.99406], [0.59654,0.99060], [0.61603,0.98635],
    [0.64491,0.97854], [0.67328,0.96902], [0.69185,0.96174], [0.71011,0.95372], [0.73688,0.94034], [0.75425,0.93055],
    [0.77955,0.91457], [0.79586,0.90310], [0.81944,0.88469], [0.84187,0.86490], [0.85616,0.85098], [0.86987,0.83650],
    [0.88933,0.81379], [0.90154,0.79802], [0.91864,0.77348], [0.92921,0.75657], [0.94378,0.73045], [0.95676,0.70351],
    [0.96451,0.68514], [0.97475,0.65704], [0.98063,0.63799], [0.98801,0.60901], [0.99196,0.58947], [0.99642,0.55990],
    [0.99841,0.54006], [0.99960,0.52016]
];
OUTLINE_PATHS = [
    [for (i = [0:127]) i]
];

module outline_2d() {
    scale([LENGTH, WIDTH]) polygon(points = OUTLINE_PTS, paths = OUTLINE_PATHS);
}

// Debossed into the bottom face, mirrored so it reads from underneath.
module version_stamp() {
    if (!is_undef(VERSION_POS) && VERSION_SIZE > 0)
        translate([VERSION_POS[0] * LENGTH, VERSION_POS[1] * WIDTH, -0.01])
            linear_extrude(VERSION_DEPTH + 0.01)
                mirror([1, 0])
                    text(str("v", VERSION), size = VERSION_SIZE,
                         font = "Liberation Sans:style=Bold",
                         halign = "center", valign = "center");
}

// Screw-head recesses and nut pockets, cut into the top or bottom face.
module fastener_cuts() {
    for (f = FASTENERS) for (c = f[1])
        translate([f[0][0] * LENGTH, f[0][1] * WIDTH,
                   c[3] == "top" ? THICKNESS - c[2] : -0.01])
            linear_extrude(c[2] + 0.01 + (c[3] == "top" ? 0.01 : 0))
                if (c[0] == "hex") circle(d = c[1] / cos(30), $fn = 6);
                else circle(d = c[1]);
}

// How far the outline is pulled in at depth d (0..r) into a finished edge.
function edge_inset(kind, r, d) =
    kind == "chamfer" ? max(0, r - d) :
    kind == "fillet"  ? r - sqrt(max(0, r * r - (r - min(d, r)) * (r - min(d, r)))) : 0;

module body() {
    nb = EDGE_BOTTOM_KIND == "none" ? 0 : ceil(EDGE_BOTTOM / LAYER - 1e-6);
    nt = EDGE_TOP_KIND    == "none" ? 0 : ceil(EDGE_TOP / LAYER - 1e-6);
    zb = nb * LAYER;
    zt = nt * LAYER;
    union() {
        // straight-walled core, overlapping the finished layers (no shared faces)
        translate([0, 0, zb - (nb > 0 ? 0.01 : 0)])
            linear_extrude(THICKNESS - zb - zt + (nb > 0 ? 0.01 : 0) + (nt > 0 ? 0.01 : 0))
                outline_2d();
        if (nb > 0) for (i = [0 : nb - 1])
            translate([0, 0, i * LAYER])
                linear_extrude(LAYER + 0.01)
                    offset(delta = -edge_inset(EDGE_BOTTOM_KIND, EDGE_BOTTOM, (i + 0.5) * LAYER))
                        outline_2d();
        if (nt > 0) for (i = [0 : nt - 1])
            translate([0, 0, THICKNESS - (i + 1) * LAYER - (i < nt - 1 ? 0.01 : 0)])
                linear_extrude(LAYER + (i < nt - 1 ? 0.01 : 0))
                    offset(delta = -edge_inset(EDGE_TOP_KIND, EDGE_TOP, (i + 0.5) * LAYER))
                        outline_2d();
    }
}

module part() {
    $fa = 2; $fs = 0.4;
    difference() {
        body();
        version_stamp();
        fastener_cuts();
    }
}

part();
