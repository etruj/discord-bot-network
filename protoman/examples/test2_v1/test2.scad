    [0.03952,0.30519], [0.02866,0.33317], [0.02236,0.35216], [0.01683,0.37139], [0.00998,0.40061], [0.00490,0.43019],
    [0.00250,0.45006], [0.00040,0.47999], [0.00000,0.50000], [0.00040,0.52001], [0.00250,0.54994], [0.00490,0.56981],
    [0.00998,0.59939], [0.01683,0.62861], [0.02236,0.64784], [0.02866,0.66683], [0.03952,0.69481], [0.04768,0.71308],
