// test2 — generated by protobot from a sketch (input.jpg)
// 2026-10-27
//
// Print: Prusa Core One, 0.4 mm nozzle, PLA, 0.2 mm layers, flat on the bed.
// The outline is stored in a 0..1 unit box and scaled by LENGTH/WIDTH, so
// the three measurements below are all you need to change. Re-export with:
//   openscad --backend=manifold --export-format binstl -o test2.stl test2.scad
//
// Dimension tags: [M] = given by the user, [S] = traced from the sketch.

/* [Measurements] */
LENGTH    = 40;   // [M] X extent, mm
WIDTH     = 40;   // [M] Y extent, mm
THICKNESS = 10;   // [M] extrusion height, mm

/* [Edge finish] */
// Perimeter edges (outline AND holes), top and bottom faces.
// "fillet" = rounded, "chamfer" = 45°, "none" = sharp. Built in LAYER steps,
// i.e. exactly as the printer will lay it down.
EDGE_TOP_KIND    = "none";
EDGE_TOP         = 0;     // mm
EDGE_BOTTOM_KIND = "none";
EDGE_BOTTOM      = 0;     // mm
LAYER            = 0.2;   // mm, print layer height

/* [Version stamp] */
VERSION        = 1;       // bump every revision
VERSION_POS    = [0.5000, 0.5000];  // [S] unit-box spot deepest inside the shape
VERSION_SIZE   = 6;      // mm text height
VERSION_DEPTH  = 0.4;    // mm, 2 layers at 0.2

/* [Hidden] */
// [S] traced outline (+ holes), unit box, y up.
OUTLINE_PTS = [
    [0.49509,0.00000], [0.46510,0.00120], [0.44517,0.00300], [0.42532,0.00560], [0.39579,0.01097], [0.37631,0.01554],
